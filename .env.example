# ───── الموقع ─────
# رابط الموقع بدون / في الآخر. محلياً: http://localhost:8888
APP_URL=https://your-site.netlify.app

# ───── تسجيل الدخول (Auth.js) ─────
# مفتاح عشوائي لتشفير الجلسات:  npx auth secret   أو   openssl rand -base64 32
AUTH_SECRET=
# بيانات OAuth Client من Google Cloud (نفسها تُستخدم لربط يوتيوب)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# الإيميل الوحيد المسموح له بالدخول
ALLOWED_EMAIL=you@gmail.com

# ───── تشفير التوكنات ─────
# مفتاح عشوائي (32 حرف أو أكثر):  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ───── Meta / Instagram ─────
META_APP_ID=
META_APP_SECRET=
# اختياري: إذا تطبيقك من نوع "Facebook Login for Business" حط رقم الـ Configuration هنا
META_CONFIG_ID=
# اختياري: إصدار Graph API (الافتراضي v25.0)
META_GRAPH_VERSION=
# اختياري: إذا عندك أكثر من صفحة فيسبوك، حدد رقم الصفحة المربوطة بانستقرام
INSTAGRAM_PAGE_ID=
